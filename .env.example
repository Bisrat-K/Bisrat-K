# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Recommended whenever the app is reachable from anywhere but your own computer.
# The web app asks for this once and remembers it on your device.
APP_PASSCODE=

# Optional
PORT=3000
HOST=127.0.0.1
TIMEZONE=Africa/Addis_Ababa
COACH_MODEL=claude-opus-5-5
# low | medium | high  (low = fastest voice replies)
COACH_EFFORT=low
